[zone_base]
period				= 1
idle_light_volumetric = true
idle_light_volumetric_intensity = 0.25
idle_light_volumetric_distance = 1
idle_light_shadow		= true
effective_radius		= 1 ;0.75 ;размер радиуса в процентах от оригинального, где действует зона
pick_dof_effector		= false
idle_light_r1			= true
script_binding          = bind_anomaly_field.bind
;bolt_entrance_particles	= anomaly2\anomaly_entrance

artefacts		= ;af_drops, 0.2, af_fireball, 0.6, af_cristall, 0.2
BirthProbability			= 0.0
spawn_blowout_artefacts		= off
min_artefact_count	= 0
max_artefact_count	= 0
artefact_spawn_idle	= 24  ;насколько часто спонить артефакты в офлайне, в часах
artefact_spawn_rnd	= 0  ;вероятность заспавнить артефакт в процентах.

min_start_power		= 0.19
max_start_power		= 0.20

artefact_spawn_probability = 0.10; 0.07				;вероятность, что во время срабатывания аномалии будет рожден артефакт
artefact_spawn_particles = anomaly2\gravi_anomaly_shield_00	;партиклы, которые отыграются на месте рождения артефакта (опционально)
artefact_born_sound =  anomaly\anomaly_gravy_hit1		;звук, который отыграются на месте рождения артефакта (опционально)

throw_out_power = 20			;импульс с которым артефакт будет выброшен из зоны в произвольном направлении
artefact_spawn_height = 1		;(м) высота на центром зоны где будет рожден артефакт

[zone_base_noshadow]:zone_base
idle_light_shadow		= false
idle_light_r1			= true
